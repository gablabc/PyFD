[flake8]
select = B,C,E,F,W
ignore = E201,E202,E203,E501,W503,D100,D101,D104,D107,D203,D205,D212,D415
extend-ignore = E2, E3, E88, E252, E123, E126, E127, E128, E265, E402, E303, E226, E261, E128, E301, E302, E124, E203, B008
strictness = short
max-line-length = 160
max-complexity = 15
docstring-convention = numpy
exclude =
    docs,
    # No need to traverse our git directory
    .git,
    # There's no value in checking cache directories
    __pycache__,
    # The conf file is mostly autogenerated, ignore it
    docs/source/conf.py,
    # This contains our built documentation
    build,
    # This contains builds of flake8 that we don't want to check
    dist

